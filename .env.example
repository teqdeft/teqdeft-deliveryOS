# ---- Database ----------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deliveryos?schema=public"

# ---- API ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-in-production-use-a-48-byte-random-string"
JWT_EXPIRES_IN="12h"
WEB_ORIGIN="http://localhost:5173"

# Where uploaded sources are written. S3 in production (blueprint §15.1);
# the local driver is for development only.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH="./storage"

# ---- AI gateway (blueprint §8) -----------------------------------------
# The gateway needs at least one provider. Jobs whose configured provider has
# no key fall back to the other; with neither key set, analysis is disabled
# and the rest of the product keeps working (§16 "graceful degradation").
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Per-job-type overrides are in apps/api/src/ai/model-policy.ts.
AI_DEFAULT_PROVIDER=ANTHROPIC
# Hard ceiling on characters sent to a model in one run (§19 cost control).
AI_MAX_INPUT_CHARS=400000
