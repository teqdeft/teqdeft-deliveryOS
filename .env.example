# ---- Database ----------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deliveryos?schema=public"

# ---- API ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-in-production-use-a-48-byte-random-string"
JWT_EXPIRES_IN="12h"
# Comma-separated list of origins allowed to call the API with credentials.
WEB_ORIGIN="http://localhost:5173"

# Where uploaded sources are written. Production wants S3-compatible encrypted
# storage (blueprint §15.1); the local driver is for development only.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH="./storage"

# ---- AI gateway (blueprint §8) -----------------------------------------
# Optional. With neither key set, analysis is disabled and everything else in
# the product keeps working — see §16, graceful degradation.
# A job whose configured provider has no key falls back to the other.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

AI_DEFAULT_PROVIDER=ANTHROPIC
# Hard ceiling on characters sent to a model in one run (§19, cost control).
# Per-job-type limits live in apps/api/src/ai/model-policy.ts.
AI_MAX_INPUT_CHARS=400000

# ---- Tests -------------------------------------------------------------
# The extraction integration tests need their own database.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deliveryos_test?schema=public"
