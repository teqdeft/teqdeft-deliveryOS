{
  "name": "teqdeft-delivery-os",
  "private": true,
  "version": "0.1.0",
  "description": "Teqdeft Delivery OS \u2014 AI-assisted delivery operating system for an agency",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @deliveryos/shared && npm run build -w @deliveryos/api && npm run build -w @deliveryos/web",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @deliveryos/api",
    "dev:web": "npm run dev -w @deliveryos/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @deliveryos/api",
    "db:seed": "npm run db:seed -w @deliveryos/api",
    "setup": "node scripts/setup.mjs",
    "db:status": "npm run db:status -w @deliveryos/api",
    "db:rollback": "npm run db:rollback -w @deliveryos/api",
    "preflight": "node deploy/preflight.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "vite": "^6.4.3"
  }
}
