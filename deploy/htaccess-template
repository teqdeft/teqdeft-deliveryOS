# Delivery OS — public_html/.htaccess
#
# Copy this to the document root of the domain or subdomain serving the app.
# It does two jobs: send /api to the Node application, and let the React
# router own every other path.

RewriteEngine On

# ---- API ---------------------------------------------------------------
# cPanel's Node.js app is already mounted at a URL by Passenger. If you set the
# application URL to the same domain with path /api, Passenger handles this and
# you can delete this block. Otherwise point it at the app's port.
#
# Replace 4000 if you changed PORT in .env.
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^api/(.*)$ http://127.0.0.1:4000/api/$1 [P,L]

RewriteCond %{REQUEST_URI} ^/health$
RewriteRule ^health$ http://127.0.0.1:4000/health [P,L]

# ---- Single-page app ---------------------------------------------------
# Anything that is not a real file falls through to index.html, so a deep link
# like /projects/<id>/requirements resolves instead of 404ing.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# ---- Caching -----------------------------------------------------------
# The build fingerprints its assets, so they can be cached hard. index.html
# must not be, or a deploy leaves users on the previous build indefinitely.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|svg|png|jpg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # The app is same-origin with its API here, so these cost nothing and close
  # off the usual clickjacking and sniffing routes.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- Compression -------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ---- Never serve secrets ----------------------------------------------
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>
